# Copy to .env.local and fill in. See SETUP.md.
#
# Without these the site still runs — it renders the demo case studies and
# posts, and /studio explains that the CMS is not connected. Nothing breaks;
# you just cannot edit content until they are set.

# From sanity.io/manage, on your project's overview page.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# The site reads two datasets. Leave these unless you named yours differently:
# "production" holds the case studies, "blog" holds the posts.
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_BLOG_DATASET=blog

# Only needed once, to run `npm run seed`. Delete it afterwards — it grants
# write access to your content, and the site never reads it.
SANITY_WRITE_TOKEN=
