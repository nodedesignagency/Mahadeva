# Copy to .env.local and fill in. See SETUP.md.
#
# Without these the site still runs — it renders the demo case studies and
# posts, and /studio explains that the CMS is not connected. Nothing breaks;
# you just cannot edit content until they are set.

# From sanity.io/manage, on your project's overview page.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# The site reads two datasets. Leave these unless you named yours differently:
# "production" holds the case studies, "blog" holds the posts.
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_BLOG_DATASET=blog

# Only needed once, to run `npm run seed`. Delete it afterwards — it grants
# write access to your content, and the site never reads it.
SANITY_WRITE_TOKEN=

# ── The site's own address ───────────────────────────────────────────────────
# No trailing slash. Drives canonical URLs, the sitemap and the share card, so
# it must be right before you go live — unset, all three say example.com.
NEXT_PUBLIC_SITE_URL=

# ── The two forms ────────────────────────────────────────────────────────────
# Any URL that accepts a JSON POST from a browser. Unset, a form validates,
# shows its sent state and throws the message away — which is fine for looking
# around and is NOT fine on a live site. See SETUP.md, "Making the forms work",
# for three services that cost nothing.
NEXT_PUBLIC_CONTACT_ENDPOINT=
NEXT_PUBLIC_CAREERS_ENDPOINT=

# Only if your form service identifies the form by a key in the body rather
# than by the URL (Web3Forms does; Formspree and FormSubmit do not). Sent as
# `access_key`. Left blank it is not sent at all.
NEXT_PUBLIC_FORM_ACCESS_KEY=
